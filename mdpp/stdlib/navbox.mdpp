::css
  /* ---- 导航框 -------------------------------------------------------- */
  /* `::navbox` 的样子。结构由 `mdpp/stdlib/navbox.mdpp` 给出，
   * 折叠的开合由 `mdpp.js` 接上 —— 与 `::tabs` 同一个分工。
   *
   * 骨架与 `::fields` 同源（那张也是左标签、右内容的两列表），所以那几条
   * padding / border / 左对齐的规矩是同一种；这里多出的是标题栏、通栏与折叠。
   */

  .mdpp-navbox {
    /* 原 1.6em -> 0.5em，减小外框上下间距 */
    margin: 0.5em 0;
    border: 1px solid var(--mdpp-border, #d8dce1);
    border-radius: var(--mdpp-radius, 8px);
    background: var(--mdpp-bg, #ffffff);
    overflow: hidden;
  }

  /* 嵌套层级：子 navbox 完全贴紧父级，去除外边距 */
  .mdpp-navbox .mdpp-navbox {
    margin: 0;
  }

  /* 嵌进去的没有标题栏也没有外框 —— 它就坐在父格的内容区里。层级靠缩进本身
   * 与标签样式分，**不画竖线**（那条线在 group-bg= 配了色的导航框里和标签
   * 底色互相打架）。 */
  .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) .mdpp-navbox__body {
    padding: 0;
    background: transparent;
  }

  /* 子表格的行间紧凑，且**不画横线** —— 通栏已经分了组，再画线是噪音。
   *
   * 选择器**必须带上 `.mdpp-navbox__group` / `.mdpp-navbox__cell`**：下面那条基础格子规则
   * 也是 (0,3,1)，不带类就打成平手、靠后的基础规则赢，padding 整个失效。 */
  .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) .mdpp-navbox__table th.mdpp-navbox__group,
  .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) .mdpp-navbox__table td.mdpp-navbox__cell {
    border-bottom: 0;
    padding: 0.25em 0.5em;
  }

  /* 次级标签列：收窄（18em → 10em）、字号略小。
   * **左 padding 极小** —— 子标签贴着父格左缘。维基那边正是如此：内容区的文字
   * （"序号 · 卫星 · 名称意义"）离左缘远，子标签（"小行星"）几乎贴着。 */
  .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) .mdpp-navbox__table th.mdpp-navbox__group {
    max-width: 10em;
    padding: 0.25em 0.5em 0.25em 0.3em;
    font-size: 0.9em;
  }

  /* 三级及更深：标签列再收窄（8em）、再小一号 */
  .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) .mdpp-navbox__table th.mdpp-navbox__group {
    max-width: 8em;
    font-size: 0.88em;
  }

  /* 子 navbox 里横排列表的分隔点更紧 */
  .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) .mdpp-navbox__cell > ul > li:not(:last-child)::after,
  .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) .mdpp-navbox__cell > ol > li:not(:last-child)::after {
    padding: 0 0.25em;
  }

  /* 模板只落 `data-mdpp-state`，不再写 `hidden`；没有脚本时也要藏住折起来的内容。
   * 有脚本时 `fold` 仍会补 `hidden`，两条规则取并集即可。 */
  .mdpp-navbox[data-mdpp-state='collapsed'] > .mdpp-navbox__body {
    display: none;
  }

  /* 没接线时（就一份 HTML 丢进浏览器）折起来的那一框照样藏着 */
  .mdpp-navbox__body[hidden] {
    display: none;
  }

  /* ---- 标题栏与开关 -------------------------------------------------- */
  /* 标题栏本身**不是**开关：点标题去开合是个不明确的交互（读者分不清那是标题还是
   * 开关）。开合是右边那个写着字的小按钮。
   *
   * 按钮绝对定位而不是并排放，是为了标题仍然**正中** —— 并排的话标题会被按钮挤偏。 */

  .mdpp-navbox__bar {
    position: relative;
    padding: 0.5em 4em;
    /* 底色与字色都来自渲染器落的自定义属性（`title-bg=`），字色是按亮度算出来的 */
    background: var(--navbox-title-bg, var(--mdpp-surface, #f6f7f9));
    color: var(--navbox-title-fg, inherit);
    text-align: center;
    font-weight: 600;
  }

  .mdpp-navbox__toggle {
    position: absolute;
    top: 50%;
    right: 0.35em;
    transform: translateY(-50%);
    padding: 0.15em 0.55em;
    border: 1px solid var(--mdpp-border, #d8dce1);
    border-radius: 4px;
    background: var(--mdpp-bg, #ffffff);
    color: var(--mdpp-text-dim, #5c636b);
    font: inherit;
    font-size: 0.82em;
    font-weight: 400;
    line-height: 1.5;
    cursor: pointer;
  }

  .mdpp-navbox__toggle:hover {
    border-color: var(--mdpp-accent, #2f6fd0);
    color: var(--mdpp-text, #1a1c1f);
  }

  /* 键盘走到哪儿要看得出来 */
  .mdpp-navbox__toggle:focus-visible {
    outline: 2px solid var(--mdpp-accent, #2f6fd0);
    outline-offset: 1px;
  }

  /* ---- 表 ------------------------------------------------------------- */
  /* 两列：左边分组名、右边内容。
   *
   * **关键**：使用默认的 `table-layout: auto`（不写即可），让浏览器按内容自动计算列宽。
   * 标签列用 `width: 1%` + `white-space: nowrap` 告诉浏览器「尽量窄，但不要断行」。
   * 超过 `max-width: 18em` 时，`overflow-wrap: anywhere` 允许换行。 */

  table.mdpp-navbox__table {
    width: 100%;
    /* 默认 auto：列宽随内容自动计算，不再强制平分 */
    border-collapse: collapse;
    /* 原浏览器默认 16px -> 0，消除表格上下边距 */
    margin: 0 !important;
  }

  .mdpp-navbox__table th,
  .mdpp-navbox__table td {
    padding: 0.25em 0.5em;
    border-bottom: 1px solid var(--mdpp-border, #d8dce1);
    font-weight: 400;
    vertical-align: middle;
  }

  /* 最后一行不用再画一条线（外面已经有边框了） */
  .mdpp-navbox__table tr:last-child th,
  .mdpp-navbox__table tr:last-child td {
    border-bottom: 0;
  }

  /* 标签列：宽度 = 内容宽度，上限 18em，超了换行。
   *
   * 核心技巧：
   * - `width: 1%` + `white-space: nowrap` → 告诉浏览器「尽量窄，但不要断行」 → 列宽 = 内容宽度
   * - `max-width: 18em` + `overflow-wrap: anywhere` → 超过上限时允许折行
   * - 不用 flex，用表格原生 `text-align: center; vertical-align: middle;` 实现居中
   *   （flex 会破坏表格单元格的原生布局行为） */

  .mdpp-navbox__group {
    width: 1%;
    white-space: nowrap;
    max-width: 18em;
    overflow-wrap: anywhere;
    /* 垂直+水平居中：用表格原生方式，不破坏表格布局 */
    text-align: center;
    vertical-align: middle;
    /* 底色来自 `group-bg=`；不给就是那一档淡底，与通栏、标题栏同一个颜色 */
    background: var(--navbox-group-bg, var(--mdpp-surface, #f6f7f9));
    color: var(--navbox-group-fg, var(--mdpp-text-dim, #5c636b));
    font-weight: 600;
    padding: 0.25em 0.5em;
    box-sizing: border-box;
  }

  /* 正常情况下的单元格 padding —— 嵌套与顶层同一份：子 navbox 就坐在父格的
   * 内容区里，和父格的列表文字同一缩进。
   *
   * 以前这里上面还有一条 `.mdpp-navbox__cell { padding: 0 }`，想把「装子 navbox 的
   * 格子」清零，但它被本条（`.mdpp-navbox__table td.mdpp-navbox__cell`，(0,3,1)）盖掉了
   * —— 优先级 (0,2,0) 对 (0,3,1)，从没生效过，注释却写着「已清零」。已删。 */
  .mdpp-navbox__table th.mdpp-navbox__group,
  .mdpp-navbox__table td.mdpp-navbox__cell {
    padding: 0.4em 0.8em;
    vertical-align: middle;
  }

  /* ---- 装着子导航框的格子 ------------------------------------------- */
  /* 水平 padding 归零：子导航框铺满整格 —— 维基那边子标签（"小行星"）就是贴着
   * 内容区左缘的，而同一格里的文字（"序号 · 卫星 · …"）离得远。**文字间距 >
   * 标签间距**，这就是那个对比。
   *
   * 左侧留 2px：两级标签的底色之间要有一道缝，完全挨在一起分不出层次
   * （是一道缝，不是竖线 —— 不用 `border`，免得在 group-bg= 配了色的框里打架）。
   *
   * 用 `:has()` 认出「哪个格子装着子框」；模板不再需要额外记号类。 */

  .mdpp-navbox__table td.mdpp-navbox__cell:has(.mdpp-navbox) {
    padding: 0.3em 0 0.3em 2px;
  }

  /* 格子里的文字（横排列表、段落）另给大缩进 —— 与子标签的 0.3em 拉开层次 */
  .mdpp-navbox__table td.mdpp-navbox__cell:has(.mdpp-navbox) > ul,
  .mdpp-navbox__table td.mdpp-navbox__cell:has(.mdpp-navbox) > ol,
  .mdpp-navbox__table td.mdpp-navbox__cell:has(.mdpp-navbox) > p {
    padding-left: 1.2em;
  }

  /* ---- 通栏：above / below / [headerN] ------------------------------- */
  /* 三者横跨两列，但**不是一回事**：`[headerN]` 是下面几行的分组标题，
   * above/below 是两句内容。所以前者的底色深一些、居中，后者更淡。
   *
   * 选择器**必须带上 `.mdpp-navbox__table`**：上面那条 `.mdpp-navbox__table td` 是 (0,2,1)，
   * 而 `.mdpp-navbox__head` 只有 (0,2,0) —— 少一个类，居中就被那条 `text-align: left`
   * 压过去了。这不是猜测：实测 `getComputedStyle(head).textAlign` 是 `left`。 */

  .mdpp-navbox__table .mdpp-navbox__head {
    background: var(--navbox-head-bg, var(--mdpp-surface, #f6f7f9));
    color: var(--navbox-head-fg, inherit);
    text-align: center;
    font-weight: 600;
  }

  .mdpp-navbox__table .mdpp-navbox__above,
  .mdpp-navbox__table .mdpp-navbox__below {
    color: var(--mdpp-text-dim, #5c636b);
    text-align: center;
    font-size: 0.94em;
  }

  .mdpp-navbox__table .mdpp-navbox__head > :first-child,
  .mdpp-navbox__table .mdpp-navbox__above > :first-child,
  .mdpp-navbox__table .mdpp-navbox__below > :first-child {
    margin-top: 0;
  }

  .mdpp-navbox__table .mdpp-navbox__head > :last-child,
  .mdpp-navbox__table .mdpp-navbox__above > :last-child,
  .mdpp-navbox__table .mdpp-navbox__below > :last-child {
    margin-bottom: 0;
  }

  /* ---- 内容格 --------------------------------------------------------- */
  /* 段落的上下外边距由行高给；不抹掉的话第一行与最后一行会格外空。 */

  .mdpp-navbox__cell > :first-child {
    margin-top: 0;
  }

  .mdpp-navbox__cell > :last-child {
    margin-bottom: 0;
  }

  /* ---- hlist：列表默认横排 ------------------------------------------- */
  /* 维基那边 navbox 自带 `hlist` 类，无序列表会显示成由小圆点分隔的水平列表。
   * 这里照做：`inline-block` 而不是 `inline` —— 前者让一条链接不被拦腰折断，
   * 折行发生在条目**之间**。
   *
   * 分隔点挂在「上一条」的后面，于是最后一条后面没有多余的那个。 */

  .mdpp-navbox__cell > ul,
  .mdpp-navbox__cell > ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mdpp-navbox__cell > ul > li,
  .mdpp-navbox__cell > ol > li {
    display: inline-block;
  }

  .mdpp-navbox__cell > ul > li:not(:last-child)::after,
  .mdpp-navbox__cell > ol > li:not(:last-child)::after {
    content: "·";
    padding: 0 0.35em;
    color: var(--mdpp-text-dim, #5c636b);
  }

  /* 里层的列表仍竖排带子弹：横排的里层在窄屏上没法读 */
  .mdpp-navbox__cell ul ul,
  .mdpp-navbox__cell ul ol,
  .mdpp-navbox__cell ol ul,
  .mdpp-navbox__cell ol ol {
    display: block;
    margin: 0;
    padding-left: 1.2em;
    list-style: disc;
  }

  .mdpp-navbox__cell ul ul > li,
  .mdpp-navbox__cell ul ol > li,
  .mdpp-navbox__cell ol ul > li,
  .mdpp-navbox__cell ol ol > li {
    display: list-item;
  }

  .mdpp-navbox__cell ul ul > li:not(:last-child)::after,
  .mdpp-navbox__cell ul ol > li:not(:last-child)::after,
  .mdpp-navbox__cell ol ul > li:not(:last-child)::after,
  .mdpp-navbox__cell ol ol > li:not(:last-child)::after {
    content: none;
  }

  /* 窄屏：分组名不再不折行（否则一列宽都被标签吃掉了），改到内容上面去 */
  @media (max-width: 34rem) {
    .mdpp-navbox__table th,
    .mdpp-navbox__table td {
      display: block;
      border-bottom: 0;
    }

    .mdpp-navbox__group {
      padding-bottom: 0.1em;
      border-bottom: 1px solid var(--mdpp-border, #d8dce1);
    }
  }

  /* 纸上展开折起来的导航框，并藏掉点不动的开关。 */
  @media print {
    .mdpp-navbox__body[hidden],
    .mdpp-navbox[data-mdpp-state='collapsed'] > .mdpp-navbox__body {
      display: block !important;
    }

    .mdpp-navbox__toggle {
      display: none;
    }

    .mdpp-navbox:not(:has(> .mdpp-navbox__bar)) {
      margin: 0;
      border-left: 0;
    }
  }

::guard
  ::if condition-local-exist={{@title}}
    [then]
    [else]
      ::if condition-local-exist={{@state}}
        [then]
          ::problem name=navbox why="没有 title= 就是嵌进去的样子，没有开关，所以 state= 在这儿没用：写 title= 才是一个完整的导航框"
  ::if condition-local-exist={{@state}}
    [then]
      ::if condition-local-equals={{@state}} value=expanded
        [then]
        [else]
          ::if condition-local-equals={{@state}} value=collapsed
            [then]
            [else]
              ::if condition-local-equals={{@state}} value=plain
                [then]
                [else]
                  ::if condition-local-equals={{@state}} value=off
                    [then]
                    [else]
                      ::problem name=navbox why="state= 只认 expanded（展开）、collapsed（一上来折着）、plain（展开但不能折）；off 是 plain 的旧写法"
  ::each skip=above,below,header required check name=navbox empty-why="导航框里一行也没有：写一个 [分组名]，下面写那一行的内容"
    [__template__]
    [__data__]
      {{body}}
  ::style-vars tag=div class=mdpp-navbox data-mdpp-state="{{?state}}" --navbox-group-bg="{{?group-bg}}" --navbox-title-bg="{{?title-bg}}" --navbox-head-bg="{{?header-bg}}"
    ::if condition-local-exist={{@title}}
      [then]
        ::element tag=div class=mdpp-navbox__bar
          ::element tag=span class=mdpp-navbox__title
            ::inline
              {{?title}}
          ::if condition-local-equals={{@state}} value=plain
            [then]
            [else]
              ::if condition-local-equals={{@state}} value=off
                [then]
                [else]
                  ::if condition-local-equals={{@state}} value=collapsed
                    [then]
                      ::element tag=button class=mdpp-navbox__toggle type=button aria-expanded=false data-mdpp-label-show=显示 data-mdpp-label-hide=隐藏 inline=on
                        显示
                    [else]
                      ::element tag=button class=mdpp-navbox__toggle type=button aria-expanded=true data-mdpp-label-show=显示 data-mdpp-label-hide=隐藏 inline=on
                        隐藏
    ::element tag=div class=mdpp-navbox__body
      ::element tag=table class=mdpp-navbox__table
        ::element tag=tbody
          ::each only=above max=1 name=navbox
            [__template__]
              ::element tag=tr
                ::element tag=td class=mdpp-navbox__above colspan=2
                  {{@item.body}}
            [__data__]
              {{body}}
          ::each skip=above,below name=navbox
            [__template__]
              ::if condition-prefix="{{@item.label}}" value=header
                [then]
                  ::problem name=navbox why="[header1] 这样的写法不认：这里不用编号，写 [header] 就好，写几条都是它"
                [else]
                  ::element tag=tr
                    ::element tag=th class=mdpp-navbox__group scope=row
                      ::inline
                        {{@item.label}}
                    ::element tag=td class=mdpp-navbox__cell
                      {{@item.body}}
            [__template__ header]
              ::if condition-yes={{@item.body_empty}}
                [then]
                  ::problem name=navbox why="[header] 是空的：通栏就是它的标题"
                [else]
                  ::element tag=tr
                    ::element tag=td class=mdpp-navbox__head colspan=2
                      {{@item.body}}
            [__template__ link]
              ::if condition-yes={{@item.empty}}
                [then]
                  ::problem name=navbox why="[link] 后面没写页面名：写 [link 某页]，也可以写 [link 某页|显示的字]"
                [else]
                  ::element tag=tr
                    ::element tag=th class=mdpp-navbox__group scope=row
                      ::inline
                        [[{{@item.label}}]]
                    ::element tag=td class=mdpp-navbox__cell
                      {{@item.body}}
            [__data__]
              {{body}}
          ::each only=below max=1 name=navbox
            [__template__]
              ::element tag=tr
                ::element tag=td class=mdpp-navbox__below colspan=2
                  {{@item.body}}
            [__data__]
              {{body}}
