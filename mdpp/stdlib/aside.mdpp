::if condition-equals={{@align}} value=center
  [then]
    ::element tag=aside class="aside aside--center {{?@class}}"
      ::if condition-exist={{@title}}
        [then]
          ::element tag=p class=aside__title inline=on
            {{?title}}
      {{body}}
  [else]
    ::if condition-equals={{@align}} value=left
      [then]
        ::element tag=aside class="aside aside--left {{?@class}}"
          ::if condition-exist={{@title}}
            [then]
              ::element tag=p class=aside__title inline=on
                {{?title}}
          {{body}}
      [else]
        ::if condition-defined={{@align}}
          [then]
            ::if condition-equals={{@align}} value=right
              [then]
                ::element tag=aside class="aside {{?@class}}"
                  ::if condition-exist={{@title}}
                    [then]
                      ::element tag=p class=aside__title inline=on
                        {{?title}}
                  {{body}}
              [else]
                ::problem name=aside why="align= 只认 right / center / left；写成了 {{?@align}}"
          [else]
            ::element tag=aside class="aside {{?@class}}"
              ::if condition-exist={{@title}}
                [then]
                  ::element tag=p class=aside__title inline=on
                    {{?title}}
              {{body}}
