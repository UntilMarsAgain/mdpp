::css
  /* 两节默认都藏着：显示哪一节由下面两条按主题挑。
   * 「两边都显示」那一节（没有 light/dark 档的）不受这两条影响。 */
  .mdpp-theme__part--light { display: none; }
  .mdpp-theme__part--dark { display: none; }

  /* 页面没有明确指定主题时，跟随系统。
   * `:not([data-mdpp-theme='…'])` 是为了让「明确说了 light 就别再被深色那条拿走」。 */
  @media (prefers-color-scheme: dark) {
    :root:not([data-mdpp-theme='light']) .mdpp-theme__part--dark { display: block; }
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-mdpp-theme='dark']) .mdpp-theme__part--light { display: block; }
  }

  /* 页面明确指定了主题：它说了算，且写在最后 —— 同优先级时后者胜出。 */
  :root[data-mdpp-theme='dark'] .mdpp-theme__part--dark { display: block; }
  :root[data-mdpp-theme='light'] .mdpp-theme__part--light { display: block; }



  @media print {
    /* 深浅色两节都出来（不然纸上只有屏幕上是深色那一半） */
    .mdpp-theme__part--light,
    .mdpp-theme__part--dark {
      display: block !important;
    }

    .mdpp-theme__part + .mdpp-theme__part {
      margin-top: 0.8em;
      border-top: 1px solid var(--mdpp-border, #d8dce1);
      padding-top: 0.6em;
    }
  }

::variants control=theme group=theme default=light class="mdpp-theme {{?@class}}" panel-class=mdpp-theme__part panel-variant-class=on label=深浅色主题
  {{body}}
