::css
  /* ::small：显示小字，适合辅助说明、备注、脚注之类的内容 */
  .mdpp-small {
    font-size: 0.85em;
    color: var(--mdpp-text-dim, #5c636b);
  }

::if condition-equals="{{@type}}" value=inline
  [then]
    ::element tag=span inline=on class="mdpp-small {{?@class}}"
      {{body}}
  [else]
    ::element class="mdpp-small {{?@class}}"
      {{body}}
