::css
  .mdpp-title-block {
    margin: 1.6em 0 0.6em;
    text-align: center;
    font-size: 1.6em;
    font-weight: 700;
  }

::if condition-defined={{@text}}
  [then]
    ::surface class="mdpp-title-block {{?@class}}" text={{?@color}} inline=on
      {{?text}}
  [else]
    ::surface class="mdpp-title-block {{?@class}}" text={{?@color}} inline=on
      {{body}}
