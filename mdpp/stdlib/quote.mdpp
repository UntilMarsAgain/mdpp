::css
  /* `::quote` 的署名（作者给了 `origin=` 时） */
  blockquote.mdpp-quote__origin,
  p.mdpp-quote__origin {
    margin-top: 0.5rem;
    font-size: 0.9em;
    color: var(--mdpp-text-dim, #5c636b);
  }

::element tag=blockquote class="mdpp-quote {{?@class}}"
  {{body}}

  ::if condition-defined={{@origin}}
    [then]
      ::element tag=p class=mdpp-quote__origin inline=on
        — {{?origin}}
